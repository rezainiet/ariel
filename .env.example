# ─────────────────────────────────────────────────────────────
# Ariel Déstockage Suisse — configuration des intégrations
# Copier ce fichier en « .env.local » et compléter avant la mise en production.
# Toutes les variables exposées au client DOIVENT commencer par VITE_.
# ─────────────────────────────────────────────────────────────

# Identité de la boutique (laisser vide tant que le nom légal n'est pas confirmé)
VITE_STORE_NAME="NOM DE LA BOUTIQUE"
VITE_SUPPORT_EMAIL=""
VITE_SUPPORT_PHONE=""

# Snapchat Pixel — https://businesshelp.snapchat.com (Snap Pixel)
# Laisser vide pour désactiver complètement le pixel.
VITE_SNAP_PIXEL_ID=""

# Fournisseur de paiement (Stripe, Datatrans, Wallee…) — À CONNECTER CÔTÉ SERVEUR.
# Ne JAMAIS placer de clé secrète côté client. Seule une clé publiable est autorisée.
VITE_PAYMENT_PUBLIC_KEY=""
VITE_PAYMENT_PROVIDER=""

# Logistique (configurable, non vérifié tant que le client n'a pas confirmé)
VITE_DISPATCH_LOCATION="Suisse"
VITE_DELIVERY_ESTIMATE_DAYS="3"
