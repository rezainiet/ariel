# ─────────────────────────────────────────────────────────────
# Ariel Déstockage Suisse — configuration des intégrations
# Copier ce fichier en « .env.local » et compléter avant la mise en production.
# Toutes les variables exposées au client DOIVENT commencer par VITE_.
# Voir LAUNCH-CHECKLIST.md : aucune valeur ne doit être inventée.
# ─────────────────────────────────────────────────────────────

# ── Identité de la boutique et du marchand (LCD art. 3 al. 1 let. s) ──
VITE_STORE_NAME="NOM DE LA BOUTIQUE"
VITE_MERCHANT_LEGAL_NAME=""      # vide = Aranden GmbH (Sàrl)
VITE_MERCHANT_STREET=""          # vide = Route du Moulin 50
VITE_MERCHANT_ZIP=""             # vide = 3977
VITE_MERCHANT_CITY=""            # vide = Granges
VITE_MERCHANT_UID=""             # vide = CHE-109.911.687
VITE_MERCHANT_REGISTER_NUMBER="" # vide = CH-626.4.007.970-5
VITE_MERCHANT_MANAGER=""         # vide = Zika Cikiric
VITE_MERCHANT_VAT_NOTE=""        # ex. « TVA incluse » si assujetti (à valider)
VITE_SUPPORT_EMAIL=""            # obligatoire (un formulaire seul ne suffit pas)
VITE_SUPPORT_PHONE=""            # recommandé

# ── Déstockage : raison RÉELLE fournie par le marchand (aucune raison inventée) ──
VITE_CLEARANCE_REASON=""

# ── Logistique (affiché seulement si confirmé) ──
VITE_DISPATCH_LOCATION=""        # vide = non affiché
VITE_DISPATCH_CITY=""            # ville réelle de l'entrepôt
VITE_CARRIER=""                  # ex. « La Poste (PostPac Economy) »
VITE_DELIVERY_ESTIMATE_DAYS=""   # délai réel confirmé ; vide = 3 jours (bandeau « Livraison en 3 jours »)

# ── Paiement — prestataire externe, vérification CÔTÉ SERVEUR ──
# Ne JAMAIS placer de clé secrète côté client.
VITE_PAYMENT_PROVIDER=""         # ex. datatrans | stripe | wallee | payrexx
VITE_CHECKOUT_API=""             # URL de NOTRE serveur (création de session + vérification)
VITE_PAYMENT_PUBLIC_KEY=""
# Moyens réellement activés chez le prestataire (sinon rien n'est affiché comme actif) :
# card, twint, visa, mastercard, amex, apple_pay, google_pay, postfinance, invoice
VITE_PAYMENT_METHODS=""

# ── Pixels publicitaires — chargés UNIQUEMENT après consentement (bannière) ──
# Les identifiants publics Meta et Snapchat approuvés sont définis dans src/config/attribution.js.

# ── Balise Google — chargée UNIQUEMENT après consentement ──
VITE_GOOGLE_TAG_ID=""                 # ex. AW-123456789 (Google Ads) ou G-XXXXXXX (GA4) ; vide = rien n'est chargé
VITE_GOOGLE_ADS_CHECKOUT_SEND_TO=""   # conversion Ads du clic « Acheter », ex. AW-123456789/AbCdEfGh ; vide = aucune

# ── Commandes (serveur) ──
# Même e-mail + même téléphone + même offre dans ce délai = une seule commande (mise à jour).
# ORDER_DEDUP_HOURS=24

# ── Avis clients : par défaut saisis dans /admin, ou plateforme externe facultative ──
VITE_REVIEWS_ENDPOINT=""

# Contrat : GET → JSON [{ id, author, location, rating (1–5), date (AAAA-MM-JJ), verified, title, body }]

# ── Motivation d'achat — uniquement des données réelles (rien n'est affiché par défaut) ──
# "true" SEULEMENT si le marchand confirme que les quantités sont réellement limitées.
VITE_CLEARANCE_LIMITED="false"
# Statut serveur (heure serveur, fin de campagne réelle, stock réel). Contrat : src/lib/storeStatus.js
# { "serverTime": ISO, "campaign": { "endsAt": ISO, "label": "…" } | null, "stock": { "available": n, "lowThreshold": n } | null }
VITE_STORE_STATUS_API=""

# ── Vidéo produit / client réelle (fichier hébergé). Vide = section masquée. ──
VITE_PRODUCT_VIDEO_URL=""
VITE_PRODUCT_VIDEO_POSTER=""
VITE_PRODUCT_VIDEO_CAPTION=""

# ── Aide à la saisie d'adresse suisse (service réel, via NOTRE serveur). Contrat : src/lib/address.js ──
VITE_ADDRESS_API=""

# ── Conditions (textes validés par le marchand). Vide = rubrique masquée. ──
VITE_RETURN_ADDRESS=""
VITE_RETURN_CONDITION=""
VITE_RETURN_COSTS=""
VITE_REFUND_TERMS=""
VITE_HOSTING_PROVIDER=""
VITE_JURISDICTION=""

# ── Archives de conception (/design, /concept-a|b|c, /v1). Absentes du build public. ──
VITE_DESIGN_PREVIEW="false"

# ── Serveur (server/index.mjs) — variables d'environnement du SERVEUR, pas de préfixe VITE_ ──
# ADMIN_PASSWORD=""     # obligatoire pour /admin (12 caractères minimum) — ne jamais le committer
# PUBLIC_ORIGIN=""      # ex. https://votre-boutique.ch (URL absolue de la photo produit)
# PORT=8787
# DATA_DIR=""           # dossier des réglages (défaut : server/data)

# ── Everflow (serveur uniquement, désactivé jusqu'à publication + approbation des images) ──
# Les trois liens CHF 4/7/10 fournis sont figés dans server/everflow.mjs.
# PUBLIC_ORIGIN doit être l'origine HTTPS publique qui sert /images/everflow/pack-{1,2,3}.
# EVERFLOW_ENABLED=false
# EVERFLOW_IMAGES_APPROVED=false
# Local preview only: enables redirect testing from localhost with localhost image URLs.
# Requires NODE_ENV=development and a localhost request; the provider cannot fetch localhost images.
# EVERFLOW_LOCAL_PREVIEW=false
# Le pixel Meta public approuvé est défini dans src/config/attribution.js.
# Les liens de paiement n'utilisent plus sub5 ; Meta Purchase est envoyé par Everflow CAPI.
# Le fbclid consenti est transmis à Everflow dans sub1 et fbclid.
